#!/usr/bin/env bash
# Pre-push gate: reproduces the CI checks locally so nothing bounces back from the PR.
# Runs the full gate only for the Go modules touched by the commits being pushed,
# plus cheap repo-wide checks (gofmt, API snapshots) that always run.
#
# Toolchain follows go.mod via GOTOOLCHAIN=auto (auto-downloads the pinned version).
# Bypass in an emergency with: git push --no-verify
# Compatible with bash 3.2 (macOS default) — no mapfile / associative arrays.
set -euo pipefail

export GOTOOLCHAIN=auto

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'; NC=$'\033[0m'
fail() { echo "${RED}✗ $*${NC}" >&2; exit 1; }
info() { echo "${YELLOW}==> $*${NC}"; }
ok()   { echo "${GREEN}✓ $*${NC}"; }

coverage_threshold() {
  case "$1" in
    .) echo 80 ;;
    fiber|mongo|redis) echo 70 ;;
    *) echo 0 ;;
  esac
}

# Owning module for a changed file: nearest ancestor dir with a go.mod ("." for root).
module_for() {
  dir="$(dirname "$1")"
  while [ "$dir" != "." ] && [ "$dir" != "/" ]; do
    [ -f "$dir/go.mod" ] && { echo "$dir"; return; }
    dir="$(dirname "$dir")"
  done
  echo "."
}

# Commit range being pushed (stdin: <localref> <localsha> <remoteref> <remotesha>).
ZERO="0000000000000000000000000000000000000000"
changed_files() {
  had_input=0
  while read -r _localref localsha _remoteref remotesha; do
    had_input=1
    if [ "$localsha" = "$ZERO" ]; then continue; fi   # branch deletion
    if [ "$remotesha" = "$ZERO" ]; then
      base="$(git merge-base origin/main "$localsha" 2>/dev/null || echo "")"
      if [ -n "$base" ]; then git diff --name-only "$base" "$localsha"
      else git show --name-only --pretty=format: "$localsha"; fi
    else
      git diff --name-only "$remotesha" "$localsha"
    fi
  done
  [ "$had_input" = 0 ] && git diff --name-only "@{push}" HEAD 2>/dev/null || true
}

FILES="$(changed_files | grep -E '\.(go|mod|sum)$' | sort -u || true)"
if [ -z "$FILES" ]; then
  ok "No Go changes to verify."
  exit 0
fi

# Map changed files to owning modules (newline-separated, deduped).
MODULES=""
while IFS= read -r f; do
  [ -n "$f" ] || continue
  MODULES="$MODULES$(module_for "$f")"$'\n'
done <<EOF
$FILES
EOF
MODULES="$(printf '%s' "$MODULES" | grep -v '^$' | sort -u)"

info "Modules to verify:" $MODULES

while IFS= read -r mod; do
  [ -n "$mod" ] || continue

  info "[$mod] tests (-race) + coverage"
  ( cd "$mod" && go test ./... -coverprofile=/tmp/eywa_cov.out -covermode=atomic -race ) \
    || fail "[$mod] tests failed"

  thr="$(coverage_threshold "$mod")"
  if [ "$thr" -gt 0 ]; then
    pct="$( ( cd "$mod" && go tool cover -func=/tmp/eywa_cov.out ) | awk '/^total:/{gsub(/%/,"",$3); print $3}')"
    echo "    coverage: ${pct}% (min ${thr}%)"
    if [ "$(echo "$pct < $thr" | bc -l)" = "1" ]; then
      fail "[$mod] coverage ${pct}% below ${thr}%"
    fi
  fi

  info "[$mod] vet"
  ( cd "$mod" && go vet ./... ) || fail "[$mod] vet failed"

  if command -v golangci-lint >/dev/null 2>&1; then
    info "[$mod] lint"
    ( cd "$mod" && golangci-lint run ./... --timeout 5m ) || fail "[$mod] lint failed"
  else
    echo "${YELLOW}    golangci-lint not installed — skipping (CI still runs it)${NC}"
  fi

  if command -v govulncheck >/dev/null 2>&1; then
    info "[$mod] govulncheck"
    ( cd "$mod" && govulncheck ./... ) || fail "[$mod] govulncheck failed"
  fi
done <<EOF
$MODULES
EOF

info "gofmt"
FMT="$(gofmt -l . | grep -v '^$' || true)"
if [ -n "$FMT" ]; then
  fail "gofmt violations (run gofmt -w .):"$'\n'"$FMT"
fi

info "API snapshots"
go doc -all github.com/wmulabs/eywa > /tmp/eywa_api_root.txt
diff -u .api-snapshot.txt /tmp/eywa_api_root.txt \
  || fail "root API snapshot drift — regenerate: go doc -all github.com/wmulabs/eywa > .api-snapshot.txt"
for m in fiber mongo redis mcp; do
  ( cd "$m" && go doc -all . ) > "/tmp/eywa_api_${m}.txt"
  diff -u ".api-snapshots/${m}.txt" "/tmp/eywa_api_${m}.txt" \
    || fail "$m API snapshot drift — regenerate: (cd $m && go doc -all .) > .api-snapshots/${m}.txt"
done

ok "All pre-push gates passed."
